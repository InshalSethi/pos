{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "acutebills",
    "version": "1.0.0",
    "description": "AcuteBills Desktop Application",
    "author": "AcuteBills",
    "private": true,
    "main": "electron/main.cjs",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "electron:dev": "concurrently -k \"npm run dev\" \"node node_modules/electron/cli.js .\"",
        "electron:start": "node node_modules/electron/cli.js .",
        "electron:build": "npm run build && npx electron-builder"
    },
    "devDependencies": {
        "@noble/hashes": "1.6.1",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "axios": "^1.8.2",
        "concurrently": "^9.0.1",
        "electron": "^41.7.1",
        "electron-builder": "24.13.3",
        "laravel-vite-plugin": "^2.0.0",
        "playwright": "^1.62.1",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.4"
    },
    "dependencies": {
        "@emoji-mart/data": "^1.2.1",
        "@fontsource/figtree": "^5.3.0",
        "@fortawesome/fontawesome-free": "^7.3.1",
        "@headlessui/vue": "^1.7.23",
        "@heroicons/vue": "^2.2.0",
        "@splinetool/viewer": "^1.12.98",
        "@vueup/vue-quill": "^1.5.5",
        "@vueuse/core": "^13.5.0",
        "alpinejs": "^3.16.1",
        "chart.js": "^4.5.0",
        "cropperjs": "^1.6.2",
        "emoji-mart": "^5.6.0",
        "html2pdf.js": "^0.14.0",
        "html5-qrcode": "^2.3.8",
        "lodash": "^4.17.21",
        "node-machine-id": "^1.1.12",
        "pinia": "^3.0.3",
        "sweetalert2": "^11.26.25",
        "vue": "^3.5.18",
        "vue-chartjs": "^5.3.2",
        "vue-final-modal": "^4.5.5",
        "vue-router": "^4.5.1"
    },
    "build": {
        "appId": "com.acutebills.desktop",
        "productName": "AcuteBills",
        "directories": {
            "output": "dist"
        },
        "files": [
            "app/**/*",
            "bootstrap/**/*",
            "config/**/*",
            "database/**/*",
            "electron/**/*",
            "public/**/*",
            "resources/**/*",
            "routes/**/*",
            "storage/**/*",
            "vendor/**/*",
            "artisan",
            "composer.json",
            "package.json",
            ".env",
            ".env.example"
        ],
        "protocols": {
            "name": "acutebills-protocol",
            "schemes": [
                "acutebills"
            ]
        },
        "win": {
            "target": "nsis"
        },
        "asar": false,
        "nsis": {
            "oneClick": false,
            "perMachine": true,
            "allowToChangeInstallationDirectory": true,
            "license": "build/license.txt",
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        }
    }
}
